{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/shruggietech/cueson/scripts/pr-policy/testdata/schema.json",
  "title": "Cueson pull-request policy fixture case",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "name",
    "scenario",
    "expected_state",
    "request_second"
  ],
  "properties": {
    "name": {
      "type": "string",
      "minLength": 1
    },
    "scenario": {
      "type": "string",
      "minLength": 1
    },
    "expected_state": {
      "enum": [
        "pending",
        "success",
        "failure",
        "error"
      ]
    },
    "request_second": {
      "type": "boolean"
    }
  }
}

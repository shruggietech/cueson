{
  "name": "@shruggietech/cueson-site",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.2",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "build": "node scripts/generate.mjs && next build",
    "deploy": "wrangler deploy",
    "deploy:dry-run": "wrangler deploy --dry-run --outdir .wrangler-dry-run",
    "dev": "node scripts/generate.mjs && next dev",
    "generate": "node scripts/generate.mjs",
    "generate:check": "node scripts/generate.mjs --check",
    "lint": "eslint .",
    "preview": "node scripts/serve.mjs out 4173",
    "test": "pnpm lint && pnpm generate && pnpm generate:check && pnpm test:unit && pnpm build && pnpm test:browser && pnpm verify:artifact && pnpm deploy:dry-run",
    "test:browser": "playwright test",
    "test:unit": "node --test tests/cloudflare-state.test.mjs tests/generator.test.mjs worker/index.test.ts",
    "verify:artifact": "node scripts/verify-artifact.mjs",
    "verify:cloudflare": "node scripts/verify-cloudflare-state.mjs",
    "verify:production": "node scripts/verify-production.mjs"
  },
  "dependencies": {
    "fumadocs-core": "16.15.9",
    "fumadocs-mdx": "15.4.0",
    "fumadocs-ui": "16.15.9",
    "lucide-react": "1.45.0",
    "next": "16.3.5",
    "next-themes": "0.4.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "4.6.2"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@cloudflare/workers-types": "5.20260911.1",
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "4.3.3",
    "@types/mdx": "2.0.14",
    "@types/node": "22.20.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.5",
    "postcss": "8.5.28",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "wrangler": "4.131.1"
  }
}

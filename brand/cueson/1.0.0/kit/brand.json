  "guide": {
    "idea": "Universal captions and subtitles",
    "descriptor": "A lossless, structured interchange layer for subtitle and caption content.",
    "foundation_title": "One predictable Cue JSON surface",
    "foundation": "Cueson performs format-specific work at the file boundary. It exposes words, timing, speakers, provenance, layout, and other useful context while retaining the original file or subtitle graphics as authoritative evidence.",
    "personality": [
      [
        "Precise",
        "Names the source format, timing, and derivation method",
        "Generic conversion claims"
      ],
      [
        "Preserving",
        "Keeps the source and normalized view together",
        "Language that implies the original is discarded"
      ],
      [
        "Readable",
        "Makes caption content directly addressable",
        "Format syntax presented as the user benefit"
      ],
      [
        "Measured",
        "Labels OCR and transcription as derived output",
        "Claims of perfect recovery"
      ]
    ],
    "promises": [
      "Subtitle and caption content reaches one predictable structured surface.",
      "The original carrier and its native details remain available.",
      "Bitmap subtitle text can be derived through OCR without replacing the images.",
      "Downstream tools no longer need a separate parser for every supported format."
    ],
    "in_scope": [
      "Text, XML, legacy binary, and bitmap subtitle formats",
      "Cue timing, speakers, text, layout, provenance, and source envelopes",
      "Derived plaintext from OCR and future transcription sources"
    ],
    "out_of_scope": [
      "Replacing authoritative source files with normalized text",
      "Claiming OCR output is lossless or authoritative",
      "Activating cueson.io or changing the Cueson product repository in this slice"
    ],
    "sharp_edge": "OCR and transcription are derived interpretations. Preserve the original visual or audio evidence and label confidence and provenance instead of presenting inferred text as ground truth.",
    "logo": "Cueframe places three unequal cue rails inside two open brackets. The brackets are the retained source envelope; the rails are directly readable structured caption content. The reduced master keeps the envelope and one rail for small sizes.",
    "palette": "Cue Teal carries product identity, focus, and selection. Archive Night and its raised surfaces keep structured content primary. ShruggieTech orange remains scarce for emphasis and warning, while success and failure retain explicit labels and shapes.",
    "specimen_line": "A lossless, structured interchange layer",
    "specimen_body": "for subtitle and caption content."
  },
